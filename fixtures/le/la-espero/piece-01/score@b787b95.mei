<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-CMN.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<mei xml:id="mei-1" xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead xml:id="meiHead-1">
      <fileDesc xml:id="fileDesc-1">
         <titleStmt xml:id="titleStmt-1">
            <title xml:id="title-1"></title>
            <title xml:id="title-2" type="subordinate">electronic transcription</title>
            <respStmt xml:id="respStmt-1">
               <persName xml:id="persName-1" role="composer">F. M. de Menil</persName>
            </respStmt>
         </titleStmt>
         <pubStmt xml:id="pubStmt-1">
            <availability xml:id="availability-1">
               <useRestrict xml:id="useRestrict-1">CC-BY-4.0</useRestrict>
            </availability>
         </pubStmt>
         <sourceDesc xml:id="sourceDesc-1">
            <source xml:id="source-1" target="#manifestation-1"/>
         </sourceDesc>
      </fileDesc>
      <encodingDesc xml:id="encodingDesc-1">
         <appInfo xml:id="appInfo-1">
            <application version="1" xml:id="lets-encode">
               <name xml:id="name-1">Let's Encode!</name>
            </application>
         </appInfo>
      </encodingDesc>
      <manifestationList xml:id="manifestationList-1">
         <manifestation xml:id="manifestation-1">
            <titleStmt xml:id="titleStmt-2">
               <title xml:id="title-3">La Espero</title>
               <respStmt xml:id="respStmt-2">
                  <persName xml:id="persName-2" role="composer">F. M. de Menil</persName>
                  <persName xml:id="persName-3" role="editor">M. Pancorbo</persName>
                  <persName xml:id="persName-4" role="lyricist">L. L. Zamenhof</persName>
               </respStmt>
            </titleStmt>
            <physDesc xml:id="physDesc-1">
               <extent xml:id="extent-1">2 pages</extent>
            </physDesc>
         </manifestation>
      </manifestationList>
      <revisionDesc xml:id="revisionDesc-1">
         <change xml:id="change-1" n="1" isodate="2026-10-01">
            <respStmt xml:id="respStmt-3">
               <persName xml:id="persName-5">musicog</persName>
            </respStmt>
            <changeDesc xml:id="changeDesc-1">
               <p xml:id="p-1">Score generated by Let's Encode!</p>
            </changeDesc>
         </change>
      </revisionDesc>
   </meiHead>
   <music xml:id="music-1">
      <facsimile xml:id="facsimile-1">
         <surface xml:id="surface-1" n="1" ulx="0" uly="0" lrx="2481" lry="3508">
            <graphic xml:id="graphic-1" target="../img/01.jpg" width="2481" height="3508"/>
         </surface>
         <surface xml:id="surface-2" n="2" ulx="0" uly="0" lrx="2481" lry="3508">
            <graphic xml:id="graphic-2" target="../img/02.jpg" width="2481" height="3508"/>
         </surface>
      </facsimile>
      <body xml:id="body-1">
         <mdiv xml:id="mdiv-1" n="1">
            <score xml:id="score-1">
               <scoreDef xml:id="scoreDef-1">
                  <staffGrp xml:id="staffGrp-1">
                     <staffDef xml:id="staffDef-1" n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4"/>
                  </staffGrp>
               </scoreDef>
               <section xml:id="section-1">
               </section>
            </score>
         </mdiv>
      </body>
