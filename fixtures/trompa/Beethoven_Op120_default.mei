                     <rend xml:id="rend-0000000423485031" halign="left" valign="middle" fontsize="100%">Beethovens Werke.<lb xml:id="lb-0000000931946803" />
                     </rend>
                     <rend xml:id="rend-0000000423485032" halign="right" valign="middle" fontsize="100%">Serie 17. <abbr xml:id="abbr-0000000045878681" type="superscription">No.</abbr> 165.<lb xml:id="lb-0000000931946807" />
