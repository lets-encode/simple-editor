                        <rend xml:id="rend-0000001631646837" halign="center" valign="middle" fontsize="100%">
                           <lb xml:id="lb-0000000495749949" />von</rend>
                        <rend xml:id="rend-0000001223265771" halign="center" valign="middle" fontsize="200%">
                           <lb xml:id="lb-0000000931946442" />L.<rend xml:id="rend-0000000420181481" fontsize="75%"> VAN</rend> BEETHOVEN.<lb xml:id="lb-0000000931946802" />
